<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobtracker.menubar</string>
  <!-- Edit ProgramArguments to point at your Python + the menubar.py path -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/CHANGE_ME/job_tracker/menubar.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGE_ME/job_tracker</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/jobtracker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/jobtracker.log</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
